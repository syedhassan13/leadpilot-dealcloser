# Copy to .env and fill in. Never commit .env.

# Required: your group's Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# Postgres for persistent memory (Supabase: Project > Connect > Session pooler URI).
# Leave empty to use a local SQLite file (fine for local dev, NOT for deployment).
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Dealer dashboard keys: business:key pairs. "*" sees all businesses. Use long random values.
# In production there are NO defaults: without this the dashboard is off.
ADMIN_TOKENS=skyline:change-me-1,autohub:change-me-2,*:change-me-3

# Signs customer tokens and dealer sessions. Required in production (python -c "import secrets;print(secrets.token_urlsafe(32))")
SESSION_SECRET=change-me-long-random

# Secret the daily GitHub Action sends to /cron/followups
CRON_SECRET=change-me-4

# Exact website origins allowed to call the API from a browser (comma separated). Never *.
ALLOWED_ORIGINS=https://your-app.vercel.app

# production (default when DATABASE_URL is set) or development
ENV=production

# Optional tuning
MODEL=claude-haiku-5-5
EFFORT=low
MAX_TOKENS=700
HISTORY_MESSAGES=16

# Abuse and cost limits (optional)
CHAT_PER_USER_PER_MIN=20
CHAT_PER_USER_PER_DAY=200
CHAT_PER_IP_PER_MIN=120
AI_TURNS_PER_DAY=5000
MAX_FOLLOWUPS_PER_RUN=20
